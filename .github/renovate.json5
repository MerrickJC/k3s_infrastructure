{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "schedule:weekly"],

  // Every dependency here reaches the live cluster the moment a PR merges - every app's
  // ArgoCD Application runs syncPolicy.automated: {prune: true, selfHeal: true}
  // (argocd-management/unified-automation.yaml). There is no post-merge staging step.
  // Renovate must never merge on its own; a human + passing CI is the only gate.
  automerge: false,
  dependencyDashboard: true,

  // Checks the OSV.dev database directly (no GitHub token permission needed, unlike the
  // older GitHub-native vulnerabilityAlerts option which depends on Dependabot alerts
  // access) and opens out-of-schedule PRs for known-vulnerable versions. Realistic
  // coverage in this repo: strong for .github/workflows/* (github-actions is a
  // well-tracked OSV ecosystem), essentially none for the Helm/Jenkins-plugin/ArgoCD
  // customManagers below - OSV doesn't carry advisories for those datasources. Jenkins
  // plugin security warnings (a real, distinct category - see the Jenkins Update
  // Center's own "warnings" feed) are handled separately by
  // jenkins-plugin-security-check.yml, since they're often "no fix available" cases that
  // no version-bump tool (this included) can act on by opening a PR.
  osvVulnerabilityAlerts: true,

  // apps/example is a permanently-excluded template folder (per CLAUDE.md), not a real
  // app - its config.yaml has literal placeholder text like "repoURL: https://<url>" that
  // would otherwise trip a harmless-but-noisy "Invalid regex manager registryUrl" warning.
  // Note: excluding this via managerFilePatterns' "!pattern" entries does NOT work - that
  // field doesn't implement gitignore-style negation (verified: a lone "!pattern" matches
  // nothing at all, so it silently fails to override the positive include) - ignorePaths
  // is the correct, actually-reliable mechanism.
  ignorePaths: ["project/code/kubernetes/apps/example/**"],

  packageRules: [
    {
      description: "Extra caution: cloudnative-pg is the postgres operator - a bad major bump risks data loss, not just downtime (see prior 'prevent postgres database contents deletion' incident).",
      matchFileNames: ["project/code/kubernetes/apps/postgresql/**"],
      matchUpdateTypes: ["major"],
      labels: ["needs-manual-review", "database"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Extra caution: cert-manager issues certs cluster-wide - a bad major bump has cluster-wide blast radius.",
      matchFileNames: ["project/code/kubernetes/apps/cert-manager/**"],
      matchUpdateTypes: ["major"],
      labels: ["needs-manual-review"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Extra caution: ArgoCD self-manages this entire cluster (syncPolicy.automated selfHeal/prune on every app) - a bad major bump here has the highest blast radius of anything in this repo, potentially breaking every other app's deployment at once.",
      matchFileNames: ["project/code/kubernetes/argocd-management/**"],
      matchUpdateTypes: ["major"],
      labels: ["needs-manual-review"],
      dependencyDashboardApproval: true,
    },
  ],

  customManagers: [
    // Helm chart versions for apps using a classic (non-OCI) chart repository - the
    // majority of apps/*/config.yaml. atlas-operator/kueue (OCI repos, handled by the
    // separate rule below) self-exclude here since their repoURL doesn't start with
    // http(s), so this regex's registryUrl group simply never matches their content.
    //
    // Every "\n\s*" before a field name (rather than a plain "\s*") is deliberate: three
    // apps carry a "# Verify the current targetRevision: helm search repo ..." comment
    // between chart: and targetRevision:, and that comment text contains the literal
    // substring "targetRevision:" itself. A lazy [\s\S]*?targetRevision: match grabs that
    // in-comment occurrence first (and captures "helm" - the next word in the comment - as
    // the "version"), not the real key two lines later. Requiring an actual newline
    // immediately before the field name forces it to match only a line that begins with
    // that key, since RE2 (which Renovate uses) doesn't support lookaround to solve this
    // the more obvious way. Verified against every real config.yaml in this repo.
    {
      customType: "regex",
      description: "Classic HTTP Helm chart repos",
      managerFilePatterns: ["project/code/kubernetes/apps/*/config.yaml"],
      matchStrings: [
        "repoURL:\\s*(?<registryUrl>https?:\\/\\/\\S+)[\\s\\S]*?\\n\\s*chart:\\s*(?<depName>\\S+)[\\s\\S]*?\\n\\s*targetRevision:\\s*(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "helm",
    },

    // Helm chart versions for apps using an OCI chart registry. Renovate's
    // docker datasource wants the full registry+path as one packageName, not a separate
    // registryUrl - verified against a real local dry-run extraction (both resolved to the
    // correct packageName/version), but keep an eye on the first real PR from this rule
    // regardless: OCI Helm chart resolution has known rough edges elsewhere in the
    // Renovate community. Same "\n\s*" reasoning as the HTTP rule above applies here too
    // (kueue's config.yaml carries the same kind of comment).
    //
    // managerFilePatterns is the same apps/*/config.yaml glob as the classic-HTTP rule
    // above - this is deliberate, not copy-paste: it means a new OCI-based app needs zero
    // Renovate config changes to be picked up, mirroring how the ArgoCD ApplicationSet
    // itself auto-discovers new apps/<name>/ folders. This used to be a hardcoded filename
    // allowlist that every future OCI app would have needed to update. Broadening it safely requires the
    // registryHost capture to properly self-exclude classic-HTTP repos - just widening
    // the old glob without this would have caused every HTTP app to *also* match here,
    // producing a second garbled "docker" dependency (packageName "https/<chart>") for
    // each. The exclusion works by requiring registryHost ([^\s:]+, i.e. no colon) to be
    // followed immediately by end-of-line: for "https://host/...", the capture stops at
    // "https" (colon-excluded), then the literal newline requirement fails since "://..."
    // immediately follows on the same line - so the whole match fails for HTTP repos, the
    // same way the HTTP rule's `https?://` requirement fails to match OCI repos. RE2 (no
    // lookaround) meant this had to be a real end-of-line anchor via a consumed \n, not a
    // lookahead - verified against every real config.yaml in this repo (2 OCI apps match
    // correctly with the right registryHost, all classic-HTTP apps correctly produce
    // no match at all).
    {
      customType: "regex",
      description: "OCI Helm chart repos",
      managerFilePatterns: ["project/code/kubernetes/apps/*/config.yaml"],
      matchStrings: [
        "repoURL:\\s*(?<registryHost>[^\\s:]+)[ \\t]*\\n\\s*chart:\\s*(?<chartName>\\S+)[\\s\\S]*?\\n\\s*targetRevision:\\s*(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
      packageNameTemplate: "{{{registryHost}}}/{{{chartName}}}",
    },

    // Pinned Jenkins plugin versions in controller.additionalPlugins. Scoped to just that
    // list (not the whole file) via matchStringsStrategy: recursive - the first matchString
    // finds the additionalPlugins block, the second extracts each "- id:version" line
    // within it, so it can't accidentally match unrelated "- key: value" lines elsewhere
    // in this file (containerEnv entries, JCasC list items, etc).
    //
    // versioningTemplate: "loose" is required, not cosmetic: the jenkins-plugins datasource
    // declares no defaultVersioning of its own, so without this Renovate falls
    // back to its global default of strict semver which CANNOT parse Jenkins plugin
    // version strings like "1421.v99cb_b_2577709" (not MAJOR.MINOR.PATCH) at all. The
    // practical effect verified against a real run: Renovate detects all 15 plugins fine,
    // but silently finds zero updates for any of them, even when one genuinely exists because
    // it can't compare unparseable versions, not because none were available. "loose"
    // versioning correctly orders these by leading numeric prefix without needing to
    // understand the ".vHASH" suffix at all
    {
      customType: "regex",
      description: "Jenkins plugin versions",
      managerFilePatterns: [
        "/^project\\/code\\/kubernetes\\/apps\\/jenkins\\/values\\.yaml$/",
      ],
      matchStringsStrategy: "recursive",
      matchStrings: [
        "additionalPlugins:[\\s\\S]*?\\n  JCasC:",
        "- (?<depName>[a-zA-Z0-9_-]+):(?<currentValue>[\\w.-]+)",
      ],
      datasourceTemplate: "jenkins-plugins",
      versioningTemplate: "loose",
    },

    // ArgoCD's own version, pinned via a raw GitHub URL (not a Helm chart or a k8s manifest
    // image tag) in argocd-management/kustomization.yaml's `resources:` list. Renovate's
    // built-in kustomize manager does NOT cover this: its extractor
    // (lib/modules/manager/kustomize/extract.ts) only recognizes the git remote-base query
    // syntax (?ref=/?version=, optionally git::-prefixed), not a plain raw.githubusercontent.com
    // URL with the version embedded in the path - verified directly against Renovate's source.
    // Without this custom manager, ArgoCD's version - arguably the single most
    // consequential pin in this repo, since it self-manages every other app - would never
    // be tracked at all.
    {
      customType: "regex",
      description: "ArgoCD's own version (raw install manifest URL)",
      managerFilePatterns: [
        "/^project\\/code\\/kubernetes\\/argocd-management\\/kustomization\\.yaml$/",
      ],
      matchStrings: [
        "raw\\.githubusercontent\\.com\\/(?<depName>[\\w-]+\\/[\\w-]+)\\/(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)\\/",
      ],
      datasourceTemplate: "github-releases",
      packageNameTemplate: "{{{depName}}}",
    },
  ],
}
