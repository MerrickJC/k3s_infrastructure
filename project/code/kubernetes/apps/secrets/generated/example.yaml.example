---
# A secret automatically generated
apiVersion: v1
kind: Secret
metadata:
  name: argocd-dex-client-secret
  namespace: secrets
  annotations:
    # autogenerates two keys into a single secret file. Must have 1 or more keys
    secret-generator.v1.mittwald.de/autogenerate: KEY_NAME,ANOTHER_KEY_NAME
    secret-generator.v1.mittwald.de/encoding: base64
    secret-generator.v1.mittwald.de/length: "32"
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    # mirrors the secret into the two namespaces specified.  Must have 1 or more namespaces
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "namespace-a,namespace-b"
type: Opaque
